{
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "hosting": {
    "public": "build/web",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "rewrites": [
      {
        "source": "**",
        "destination": "/index.html"
      }
    ]
  },
  "storage": {
    "rules": "storage.rules"
  },
  "functions": {
    "source": "functions",
    "runtime": "python311",
    "predeploy": [
      ". \"$RESOURCE_DIR/venv/bin/activate\" && python3 -m pip install -r \"$RESOURCE_DIR/requirements.txt\""
    ]
  }

}
